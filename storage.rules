rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Rol del usuario logueado, leído desde su documento en Firestore
    // (misma lógica que firestore.rules).
    function rolDe(uid) {
      return firestore.get(/databases/(default)/documents/usuarios/$(uid)).data.role;
    }

    function esStaff() {
      return request.auth != null && rolDe(request.auth.uid) in ['Admin', 'Tecnico'];
    }

    function esAdmin() {
      return request.auth != null && rolDe(request.auth.uid) == 'Admin';
    }

    // Nivel del Personal con perfil en un módulo (mismo criterio que nivelDe
    // en firestore.rules). Los archivos se suben antes de crear el documento,
    // así que para escribir alcanza con poder emitir ese tipo.
    function nivelDe(modulo) {
      let usuario = firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
      return request.auth != null && usuario.role == 'Personal'
        ? usuario.get('permisos', {}).get(modulo, 'ninguno')
        : 'ninguno';
    }

    function personalLee(modulo, datos) {
      let nivel = nivelDe(modulo);
      return nivel in ['ver', 'todos']
        || (nivel == 'propios' && request.auth.token.email == datos.get('usuarioCreador', null));
    }

    function personalEmite(modulo) {
      return nivelDe(modulo) in ['propios', 'todos'];
    }

    // Dueño del documento o cuenta principal que lo tiene vinculado (mismo
    // criterio que puedeVerCliente en firestore.rules).
    function puedeVerCliente(clienteId) {
      return request.auth != null && (
        clienteId == request.auth.uid
        || clienteId in firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.get('cuentasVinculadas', [])
      );
    }

    // Documento emitido a una empresa/sede: el usuario tiene habilitado ese
    // tipo para esa sede o para todas (mismo criterio que puedeVer en
    // firestore.rules).
    function puedeVer(tipo, datos) {
      let empresaId = datos.get('empresaId', null);
      let sedeId = datos.get('sedeId', null);
      let accesosEmpresa = request.auth != null && empresaId is string
        ? firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.get('accesos', {}).get(empresaId, {})
        : {};
      return (sedeId is string && tipo in accesosEmpresa.get(sedeId, []))
        || tipo in accesosEmpresa.get('*', []);
    }

    // Lectura del archivo de un documento: por dueño/cuenta vinculada o por
    // accesos a empresa, mientras conviven los dos modelos.
    function puedeVerDocumento(tipo, datos) {
      return puedeVerCliente(datos.get('clienteId', null)) || puedeVer(tipo, datos);
    }

    // Fotos de las órdenes de trabajo: el staff (Admin/Técnico anterior) y
    // el Personal con acceso a OT.
    match /ordenes-trabajo/{otId}/{fileName} {
      allow read: if esStaff() || nivelDe('orden') != 'ninguno';
      allow write: if esStaff() || personalEmite('orden');
    }

    // Fotos de Mantenimiento Preventivo: mismo criterio que ordenes-trabajo.
    match /mantenimiento-preventivo/{mpId}/{fileName} {
      allow read: if esStaff() || nivelDe('mantenimiento') != 'ninguno';
      allow write: if esStaff() || personalEmite('mantenimiento');
    }

    // PDFs de facturas: los sube/borra el Admin o el Personal que emite
    // facturas (igual que firestore.rules en /facturas). Quien puede ver la
    // factura puede descargar su PDF; para eso se lee el documento de
    // Firestore de este facturaId.
    match /facturas/{facturaId}/{fileName} {
      allow read: if esAdmin()
        || personalLee('factura', firestore.get(/databases/(default)/documents/facturas/$(facturaId)).data)
        || puedeVerDocumento('factura', firestore.get(/databases/(default)/documents/facturas/$(facturaId)).data);
      allow write: if esAdmin() || personalEmite('factura');
    }

    // Fotos/PDFs de certificados: mismo criterio que facturas.
    match /certificados/{certificadoId}/{fileName} {
      allow read: if esAdmin()
        || personalLee('certificado', firestore.get(/databases/(default)/documents/certificados/$(certificadoId)).data)
        || puedeVerDocumento('certificado', firestore.get(/databases/(default)/documents/certificados/$(certificadoId)).data);
      allow write: if esAdmin() || personalEmite('certificado');
    }

    // Todo lo demás, denegado por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
