rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Rol del usuario logueado, leído desde su documento en Firestore
    // (misma lógica que firestore.rules).
    function rolDe(uid) {
      return firestore.get(/databases/(default)/documents/usuarios/$(uid)).data.role;
    }

    function esStaff() {
      return request.auth != null && rolDe(request.auth.uid) in ['Admin', 'Tecnico'];
    }

    function esAdmin() {
      return request.auth != null && rolDe(request.auth.uid) == 'Admin';
    }

    // Dueño del documento o cuenta principal que lo tiene vinculado (mismo
    // criterio que puedeVerCliente en firestore.rules).
    function puedeVerCliente(clienteId) {
      return request.auth != null && (
        clienteId == request.auth.uid
        || clienteId in firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.get('cuentasVinculadas', [])
      );
    }

    // Documento emitido a una empresa/sede: el usuario tiene habilitado ese
    // tipo para esa sede o para todas (mismo criterio que puedeVer en
    // firestore.rules).
    function puedeVer(tipo, datos) {
      let empresaId = datos.get('empresaId', null);
      let sedeId = datos.get('sedeId', null);
      let accesosEmpresa = request.auth != null && empresaId is string
        ? firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.get('accesos', {}).get(empresaId, {})
        : {};
      return (sedeId is string && tipo in accesosEmpresa.get(sedeId, []))
        || tipo in accesosEmpresa.get('*', []);
    }

    // Lectura del archivo de un documento: por dueño/cuenta vinculada o por
    // accesos a empresa, mientras conviven los dos modelos.
    function puedeVerDocumento(tipo, datos) {
      return puedeVerCliente(datos.get('clienteId', null)) || puedeVer(tipo, datos);
    }

    // Fotos de las órdenes de trabajo: solo el staff (Admin/Tecnico) puede
    // subirlas, leerlas o borrarlas.
    match /ordenes-trabajo/{otId}/{fileName} {
      allow read, write: if esStaff();
    }

    // Fotos de Mantenimiento Preventivo: mismo criterio que ordenes-trabajo.
    match /mantenimiento-preventivo/{mpId}/{fileName} {
      allow read, write: if esStaff();
    }

    // PDFs de facturas: solo el Admin sube/borra (igual que firestore.rules
    // en /facturas). El Cliente que puede ver la factura puede descargar su
    // PDF; para eso se lee el documento de Firestore de este facturaId.
    match /facturas/{facturaId}/{fileName} {
      allow read: if esAdmin() || puedeVerDocumento('factura',
        firestore.get(/databases/(default)/documents/facturas/$(facturaId)).data
      );
      allow write: if esAdmin();
    }

    // Fotos/PDFs de certificados: mismo criterio que facturas.
    match /certificados/{certificadoId}/{fileName} {
      allow read: if esAdmin() || puedeVerDocumento('certificado',
        firestore.get(/databases/(default)/documents/certificados/$(certificadoId)).data
      );
      allow write: if esAdmin();
    }

    // Todo lo demás, denegado por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
