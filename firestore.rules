rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rol del usuario logueado, leído desde su propio documento en /usuarios.
    // Nota: esto NO es un ciclo con las reglas de /usuarios de abajo, porque
    // las reglas solo controlan escrituras vía la API; get() siempre puede
    // leer el documento para evaluar la condición.
    function rolDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.role;
    }

    function esAdmin() {
      return request.auth != null && rolDe(request.auth.uid) == 'Admin';
    }

    // Admin y el rol Técnico anterior a los perfiles (mientras dura la
    // migración, el Técnico conserva exactamente el acceso que tenía).
    function esStaff() {
      return request.auth != null && rolDe(request.auth.uid) in ['Admin', 'Tecnico'];
    }

    // Personal con perfil: lo que puede hacer lo dicen sus `permisos`
    // ({ modulo: 'ninguno' | 'ver' | 'propios' | 'todos' }), que copia el
    // Admin desde el perfil asignado (ver app/lib/permisos.js).
    function esPersonal() {
      return request.auth != null && rolDe(request.auth.uid) == 'Personal';
    }

    function nivelDe(modulo) {
      return esPersonal()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('permisos', {}).get(modulo, 'ninguno')
        : 'ninguno';
    }

    function esPropietario(clienteId) {
      return request.auth != null && request.auth.uid == clienteId;
    }

    // Cuentas cliente cuyos documentos puede ver además de los suyos (ej. una
    // administración principal que ve todo lo de una sub-cuenta). Vínculo de
    // un solo sentido y no transitivo; solo lo edita un Admin (ver /usuarios).
    function cuentasVinculadasDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.get('cuentasVinculadas', []);
    }

    // Lectura de un documento de cliente: el dueño, o una cuenta principal
    // que lo tenga vinculado.
    function puedeVerCliente(clienteId) {
      return esPropietario(clienteId)
        || (request.auth != null && clienteId in cuentasVinculadasDe(request.auth.uid));
    }

    // Accesos de un usuario Cliente a documentos de empresas (los asigna solo
    // un Admin, ver /usuarios): { [empresaId]: { [sedeId | '*']: [tipos] } }.
    // '*' = todas las sedes de esa empresa, incluidas las que se creen después.
    function accesosDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.get('accesos', {});
    }

    // Lectura de un documento emitido a una empresa/sede: el usuario tiene
    // habilitado ese tipo de documento para esa sede (o para todas). Convive
    // con puedeVerCliente mientras dura la migración a empresas.
    function puedeVer(tipo, datos) {
      let empresaId = datos.get('empresaId', null);
      let sedeId = datos.get('sedeId', null);
      let accesosEmpresa = request.auth != null && empresaId is string
        ? accesosDe(request.auth.uid).get(empresaId, {})
        : {};
      return (sedeId is string && tipo in accesosEmpresa.get(sedeId, []))
        || tipo in accesosEmpresa.get('*', []);
    }

    // Quien creó un documento: compara contra el email guardado en
    // `usuarioCreador` al crearlo, igual que ya se usa
    // request.auth.token.email en esSuperAdmin().
    function esCreador(datos) {
      return request.auth != null && request.auth.token.email == datos.get('usuarioCreador', null);
    }

    // Personal según su nivel en un tipo de documento. "propios" solo alcanza
    // lo que creó, y al editar no puede pasárselo a otra persona.
    function personalLee(modulo, datos) {
      let nivel = nivelDe(modulo);
      return nivel in ['ver', 'todos'] || (nivel == 'propios' && esCreador(datos));
    }

    function personalCrea(modulo) {
      let nivel = nivelDe(modulo);
      return nivel == 'todos' || (nivel == 'propios' && esCreador(request.resource.data));
    }

    function personalEdita(modulo) {
      let nivel = nivelDe(modulo);
      return nivel == 'todos'
        || (nivel == 'propios' && esCreador(resource.data) && esCreador(request.resource.data));
    }

    function personalBorra(modulo) {
      let nivel = nivelDe(modulo);
      return nivel == 'todos' || (nivel == 'propios' && esCreador(resource.data));
    }

    // Módulos que no son documentos (finanzas, lista de precios, etc.).
    function personalVeModulo(modulo) {
      return nivelDe(modulo) in ['ver', 'todos'];
    }

    // Quien puede crear un tipo de documento (para leer lo que ese
    // formulario necesita, ej. la lista de precios en un presupuesto).
    function personalEmite(modulo) {
      return nivelDe(modulo) in ['propios', 'todos'];
    }

    // Única cuenta con permiso para configurar la suscripción de la app
    // (monto, vencimiento, habilitar/deshabilitar). Identificada por email,
    // no por "role": esa cuenta sigue con role Admin en /usuarios, así que
    // esAdmin() también la cubre para lectura.
    function esSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'marcosotola@gmail.com';
    }

    // Cuentas staff creadas manualmente en Firebase Auth antes de que existiera
    // esta colección de roles: se les permite auto-provisionar su propio
    // documento como Admin la primera vez que entran (bootstrap único).
    function esCuentaAdminHistorica() {
      return request.auth.token.email in ['marcosotola@gmail.com', 'spitelalan@gmail.com'];
    }

    // Usuarios: cada uno gestiona su propio perfil; el rol solo lo cambia un Admin
    // (salvo el bootstrap único de las cuentas históricas de arriba).
    // cuentasVinculadas, accesos, perfilId y permisos dan acceso a documentos
    // o módulos, así que igual que el rol: el propio usuario nunca puede
    // ponérselos ni cambiarlos.
    match /usuarios/{uid} {
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && !('cuentasVinculadas' in request.resource.data)
                    && !('accesos' in request.resource.data)
                    && !('permisos' in request.resource.data)
                    && !('perfilId' in request.resource.data)
                    && (
                      request.resource.data.role == 'Cliente'
                      || (request.resource.data.role == 'Admin' && esCuentaAdminHistorica())
                    );
      // La cuenta principal lee el perfil de sus vinculadas para mostrar su
      // nombre y sus sedes en el portal.
      allow read: if request.auth != null && (
                    request.auth.uid == uid
                    || esStaff()
                    || uid in cuentasVinculadasDe(request.auth.uid)
                  );
      allow update: if request.auth != null && (
                      (request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.get('cuentasVinculadas', []) == resource.data.get('cuentasVinculadas', [])
                        && request.resource.data.get('accesos', {}) == resource.data.get('accesos', {})
                        && request.resource.data.get('permisos', {}) == resource.data.get('permisos', {})
                        && request.resource.data.get('perfilId', null) == resource.data.get('perfilId', null))
                      || esAdmin()
                    );
      allow delete: if esAdmin();
    }

    // Perfiles de permisos del personal: solo el Admin los ve y los edita.
    match /perfiles/{id} {
      allow read, write: if esAdmin();
    }

    // Documentos de gestión interna: el Admin (y el Técnico anterior) tienen
    // acceso completo; el Personal según su nivel; un Cliente solo lee los
    // que le corresponden, nunca los escribe.
    match /presupuestos/{id} {
      allow read: if esStaff() || personalLee('presupuesto', resource.data) || puedeVerCliente(resource.data.clienteId) || puedeVer('presupuesto', resource.data);
      allow create: if esStaff() || personalCrea('presupuesto');
      allow update: if esStaff() || personalEdita('presupuesto');
      allow delete: if esStaff() || personalBorra('presupuesto');
    }

    match /estados/{id} {
      allow read: if esStaff() || personalLee('estado', resource.data) || puedeVerCliente(resource.data.clienteId) || puedeVer('estado', resource.data);
      allow create: if esStaff() || personalCrea('estado');
      allow update: if esStaff() || personalEdita('estado');
      allow delete: if esStaff() || personalBorra('estado');
    }

    match /remitos/{id} {
      allow read: if esStaff() || personalLee('remito', resource.data) || puedeVerCliente(resource.data.clienteId) || puedeVer('remito', resource.data);
      allow create: if esStaff() || personalCrea('remito');
      allow update: if esStaff() || personalEdita('remito');
      allow delete: if esStaff() || personalBorra('remito');
    }

    match /recibos/{id} {
      allow read: if esStaff() || personalLee('recibo', resource.data) || puedeVerCliente(resource.data.clienteId) || puedeVer('recibo', resource.data);
      allow create: if esStaff() || personalCrea('recibo');
      allow update: if esStaff() || personalEdita('recibo');
      allow delete: if esStaff() || personalBorra('recibo');
    }

    // Informes: un Cliente solo los lee si tiene habilitado el tipo
    // 'informe' para esa empresa/sede.
    match /documentos/{id} {
      allow read: if esStaff() || personalLee('informe', resource.data) || puedeVer('informe', resource.data);
      allow create: if esStaff() || personalCrea('informe');
      allow update: if esStaff() || personalEdita('informe');
      allow delete: if esStaff() || personalBorra('informe');
    }

    // El Admin gestiona todas las OT. El Técnico anterior solo las que él
    // mismo creó (usuarioCreador == su email); el Personal según su nivel.
    match /ordenesTrabajo/{id} {
      allow read: if esAdmin() || personalLee('orden', resource.data) || puedeVerCliente(resource.data.clienteId) || puedeVer('orden', resource.data) || esCreador(resource.data);
      allow create: if esAdmin() || (esStaff() && esCreador(request.resource.data)) || personalCrea('orden');
      allow update: if esAdmin() || (esStaff() && esCreador(resource.data)) || personalEdita('orden');
      allow delete: if esAdmin() || (esStaff() && esCreador(resource.data)) || personalBorra('orden');
    }

    // Mismo criterio que ordenesTrabajo.
    match /mantenimientosPreventivos/{id} {
      allow read: if esAdmin() || personalLee('mantenimiento', resource.data) || puedeVerCliente(resource.data.clienteId) || puedeVer('mantenimiento', resource.data) || esCreador(resource.data);
      allow create: if esAdmin() || (esStaff() && esCreador(request.resource.data)) || personalCrea('mantenimiento');
      allow update: if esAdmin() || (esStaff() && esCreador(resource.data)) || personalEdita('mantenimiento');
      allow delete: if esAdmin() || (esStaff() && esCreador(resource.data)) || personalBorra('mantenimiento');
    }

    // Facturas emitidas (PDF real subido a Storage + estado pendiente/pagado):
    // el Admin y el Personal según su nivel (el Técnico anterior no). El
    // Cliente solo puede leer las suyas, nunca escribirlas.
    match /facturas/{id} {
      allow read: if esAdmin() || personalLee('factura', resource.data) || puedeVerCliente(resource.data.clienteId) || puedeVer('factura', resource.data);
      allow create: if esAdmin() || personalCrea('factura');
      allow update: if esAdmin() || personalEdita('factura');
      allow delete: if esAdmin() || personalBorra('factura');
    }

    // Certificados (fotos o PDF por cliente y sede): mismo criterio que
    // Facturas.
    match /certificados/{id} {
      allow read: if esAdmin() || personalLee('certificado', resource.data) || puedeVerCliente(resource.data.clienteId) || puedeVer('certificado', resource.data);
      allow create: if esAdmin() || personalCrea('certificado');
      allow update: if esAdmin() || personalEdita('certificado');
      allow delete: if esAdmin() || personalBorra('certificado');
    }

    // Plantillas de inspección (checklists reutilizables para adjuntar a una
    // OT o un Mantenimiento): las lee quien las gestiona o quien completa
    // esos documentos; solo el Admin (o Personal con nivel "todos") las
    // crea, edita o borra.
    match /plantillas/{id} {
      allow read: if esStaff() || personalVeModulo('plantillas') || personalEmite('orden') || personalEmite('mantenimiento');
      allow write: if esAdmin() || nivelDe('plantillas') == 'todos';
    }

    // Empresas y sus sedes: todo el personal las lee para emitir documentos;
    // las gestiona el Admin o el Personal con nivel "todos". Un Cliente lee
    // las empresas en las que tiene algún acceso (nombre y sedes del portal).
    match /empresas/{empresaId} {
      allow read: if esStaff() || esPersonal() || (request.auth != null && empresaId in accesosDe(request.auth.uid));
      allow write: if esAdmin() || nivelDe('empresas') == 'todos';
    }

    // Lista de precios: también la lee quien emite presupuestos (buscador de
    // precios del formulario).
    match /listaPrecios/{id} {
      allow read: if esStaff() || personalVeModulo('listaPrecios') || personalEmite('presupuesto');
      allow write: if esStaff() || nivelDe('listaPrecios') == 'todos';
    }

    // Movimientos financieros (ingresos/gastos manuales): datos sensibles de
    // ganancias del negocio, solo Admin o Personal con acceso a Finanzas.
    match /movimientos/{id} {
      allow read: if esAdmin() || personalVeModulo('finanzas');
      allow write: if esAdmin() || nivelDe('finanzas') == 'todos';
    }

    // Suscripción de la app: cualquier Admin (incluido el SuperAdmin) puede
    // leer monto y vencimiento, pero solo el SuperAdmin puede modificarlos o
    // habilitar/deshabilitar la app.
    match /config/{id} {
      allow read: if esAdmin();
      allow write: if esSuperAdmin();
    }

    // Consultas: cualquiera puede crear (formulario público de contacto);
    // las leen el Admin y el Personal con acceso, y las marcan o borran
    // quienes tienen nivel "todos".
    match /consultas/{id} {
      allow create: if true;
      allow read: if esStaff() || personalVeModulo('consultas');
      allow update, delete: if esStaff() || nivelDe('consultas') == 'todos';
    }

    // Todo lo demás, denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
