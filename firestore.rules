rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Documentos de gestión interna: solo accesibles logueado (panel admin)
    match /presupuestos/{id} {
      allow read, write: if request.auth != null;
    }

    match /estados/{id} {
      allow read, write: if request.auth != null;
    }

    match /remitos/{id} {
      allow read, write: if request.auth != null;
    }

    match /recibos/{id} {
      allow read, write: if request.auth != null;
    }

    match /documentos/{id} {
      allow read, write: if request.auth != null;
    }

    // Consultas: cualquiera puede crear (formulario público de contacto),
    // pero solo el admin logueado puede leerlas, marcarlas o borrarlas.
    match /consultas/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Todo lo demás, denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
